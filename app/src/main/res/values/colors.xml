<?xml version="1.0" encoding="utf-8"?>
<!--
  Semantic tokens only. Screens and drawables reference these names, never raw
  hex, so the palette can change in one place.

  Palette: "cinema dark + play red" — true black for OLED, crimson for action.
-->
<resources>

    <!-- Surfaces, darkest to lightest -->
    <color name="bg">#FF000000</color>
    <color name="surface">#FF0C0C0D</color>
    <color name="surface_raised">#FF141416</color>
    <color name="surface_muted">#FF181818</color>
    <color name="border">#FF262629</color>

    <!-- Text -->
    <color name="text_primary">#FFF8FAFC</color>
    <color name="text_secondary">#FF94A3B8</color>
    <color name="text_disabled">#FF5A6472</color>

    <!-- Brand accent: actions and emphasis -->
    <color name="accent">#FFE11D48</color>
    <color name="accent_pressed">#FFBE123C</color>
    <color name="accent_disabled">#FF4A1220</color>
    <color name="on_accent">#FFFFFFFF</color>
    <color name="accent_dim">#22E11D48</color>

    <!--
      Status colours. The brand accent is already red, so failures must NOT also
      be plain red or the two become indistinguishable. Warnings use amber, and
      every status is paired with a glyph so meaning never rests on colour alone.
    -->
    <color name="positive">#FF22C55E</color>
    <color name="warning">#FFF59E0B</color>
    <color name="negative">#FFFB7185</color>

    <color name="ripple">#33E11D48</color>

    <!--
      Monogram tints. Held in the red-through-violet neighbourhood so avatars
      read as part of the crimson theme rather than a random rainbow, and kept
      dark enough that white letters stay legible on top.
    -->
    <color name="tint_1">#FF7F1D2E</color>
    <color name="tint_2">#FF8C2F1B</color>
    <color name="tint_3">#FF6D2144</color>
    <color name="tint_4">#FF5B2A6B</color>
    <color name="tint_5">#FF7A3410</color>
    <color name="tint_6">#FF4C2338</color>

</resources>
