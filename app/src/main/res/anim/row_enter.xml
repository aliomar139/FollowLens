<?xml version="1.0" encoding="utf-8"?>
<!--
  Rows arrive from slightly below and fade in. The travel is 12dp, well under
  the distance at which motion starts to feel like the list is being thrown at
  you, and it points in the direction the list continues.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/decel_soft">
    <translate
        android:duration="260"
        android:fromYDelta="12dp"
        android:toYDelta="0" />
    <alpha
        android:duration="220"
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
