<?xml version="1.0" encoding="utf-8"?>
<!--
  A soft edge where scrolling content meets floating chrome, instead of a 1dp
  divider. A rule would sit there permanently; the fade only does anything where
  something is actually passing underneath.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/bg"
        android:endColor="@color/chrome_fade" />
</shape>
