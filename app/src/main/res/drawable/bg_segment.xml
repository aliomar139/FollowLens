<?xml version="1.0" encoding="utf-8"?>
<!--
  One segment of a segmented control. Unselected segments are fully transparent,
  so the track behind them is their only background and just one segment ever
  carries a fill. That is what makes "which list am I looking at" answerable
  without reading any text.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_neutral">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/accent_bright"
                        android:endColor="@color/accent" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
