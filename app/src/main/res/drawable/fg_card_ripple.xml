<?xml version="1.0" encoding="utf-8"?>
<!--
  Press feedback drawn over a card whose background is already a gradient. A
  ripple in the background slot would have replaced that gradient; as a
  foreground it sits on top, and the mask keeps it inside the card's radius
  instead of flooding the corners.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
