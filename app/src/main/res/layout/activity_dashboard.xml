<?xml version="1.0" encoding="utf-8"?>
<!--
  The screen is a single column of content with the actions floating over it.

  Putting the scan button in a bar at the bottom rather than in a row halfway
  down does two things: it stays reachable with a thumb on a tall phone, and it
  stops the primary action from scrolling away the moment the list is used.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header. A large title, then the app's one line of voice beneath it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                style="@style/Text.Title" />

            <!--
              The account lives top-right, the corner every platform reserves
              for "who am I signed in as". Its popover opens from this button,
              so the two stay visibly connected.
            -->
            <ImageButton
                android:id="@+id/account"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/account_open"
                android:padding="10dp"
                android:src="@drawable/ic_account" />

        </LinearLayout>

        <!-- Status line: idle, scanning, or a failure reason. -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            style="@style/Text.Caption" />

        <!--
          Stat tiles. Each one is a control: tapping it selects the list it
          counts, which is the thing you wanted to do anyway after reading it.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp">

            <com.kira.followlens.ui.StatCard
                android:id="@+id/stat_followers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                app:statLabel="@string/followers" />

            <com.kira.followlens.ui.StatCard
                android:id="@+id/stat_following"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                app:statLabel="@string/following" />

            <com.kira.followlens.ui.StatCard
                android:id="@+id/stat_mutuals"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                app:statLabel="@string/mutuals" />

        </LinearLayout>

        <!--
          List picker. Every choice is on screen; the row scrolls sideways
          rather than compressing five labels into a width none of them fit.
        -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_segment_track"
            android:padding="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/list_segments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Search. The icon sits inside the field, next to what it acts on. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp">

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="48dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_disabled"
                android:textSize="15sp" />

            <!-- Shown only while there is something to clear. -->
            <ImageButton
                android:id="@+id/search_clear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search_clear"
                android:padding="8dp"
                android:src="@drawable/ic_clear"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/list_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp"
            style="@style/Text.StatLabel" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!--
              The bottom padding is the height of the floating bar plus its
              margin, so the last row can be scrolled clear of the chrome
              instead of resting permanently underneath it.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="96dp"
                android:scrollbars="vertical" />

            <!-- Empty state, never a blank pane. -->
            <TextView
                android:id="@+id/list_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:visibility="gone"
                style="@style/Text.Caption" />

        </FrameLayout>

    </LinearLayout>

    <!--
      A soft edge where the list passes under the bar. A 1dp divider would be
      there whether or not anything is behind it; the fade only appears where
      content actually meets the chrome.
    -->
    <View
        android:id="@+id/scroll_fade"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="76dp"
        android:background="@drawable/bg_scroll_fade"
        android:rotation="180"
        android:visibility="invisible" />

    <!-- Floating action bar. The scan leads; the two screens follow as icons. -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_chrome"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!--
          The scan button reports its own progress. A separate bar elsewhere on
          the screen made the user connect two things; the feedback belongs on
          the control that caused it, showing the same running count the
          notification shows.
        -->
        <FrameLayout
            android:id="@+id/refresh"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:clipToOutline="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/refresh_icon"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_scan" />

                <TextView
                    android:id="@+id/refresh_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.01"
                    android:text="@string/refresh"
                    android:textColor="@color/on_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!--
              Indeterminate, and it stays that way: the endpoint never reports a
              total, so any percentage here would be invented and would have to
              run backwards when the guess turned out wrong. The count in the
              label is the real progress; this only says "still working".
            -->
            <ProgressBar
                android:id="@+id/scan_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:indeterminate="true"
                android:indeterminateTint="@color/on_accent"
                android:visibility="invisible" />

        </FrameLayout>

        <ImageButton
            android:id="@+id/view_changes"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/changes"
            android:padding="14dp"
            android:src="@drawable/ic_changes" />

        <ImageButton
            android:id="@+id/view_history"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/history"
            android:padding="14dp"
            android:src="@drawable/ic_history" />

    </LinearLayout>

</FrameLayout>
